# Copy to .env.local (gitignored) and fill in. Nothing in the repo writes this file,
# and nothing prints its values.

# ── App build ────────────────────────────────────────────────────────────────
# Comma-separated addresses shown the admin usage screen (Settings → Utilisateurs).
# Baked into the bundle at build time by Vite. This only makes the app OFFER the screen;
# the matching RLS policy in docs/SCHEMA.sql decides whether any data comes back.
VITE_ADMIN_EMAILS=

# Your OWN Supabase project (accounts, ledger, usage log) — optional. Without these the
# app runs account-less (own-key / access-code modes). The same two values, unprefixed
# (SUPABASE_URL / SUPABASE_ANON_KEY), go into the Netlify environment for the functions.
# The publishable anon key is public by design; RLS guards every row.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Credentials for scripts/causerie.mjs (terminal access to your own data) ──

# The account you sign into the app with. Used for a normal Supabase password sign-in,
# exactly as the browser does — needed for `costs` and `events`.
# If you only ever sign in with Google, set a password once under Supabase → Authentication.
CAUSERIE_EMAIL=
CAUSERIE_PASSWORD=

# The device-sync code, for reading the synced profile (`memory`, `sessions`, `transcript`).
# App → Profils → the sync code shown there.
CAUSERIE_SYNC_TOKEN=

# Only needed if the deployment still gates the functions behind the legacy access code.
CAUSERIE_ACCESS_CODE=

# Which deployment and which Supabase project the script reads — no defaults.
# CAUSERIE_SITE=https://your-site.netlify.app
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
