{
  "name": "causerie",
  "version": "0.2.0",
  "description": "Voice conversation tutor with a CEFR-mapped memory",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --config vite.single.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "keywords": [
    "language-learning",
    "french",
    "spaced-repetition",
    "openai-realtime",
    "voice",
    "tutor"
  ],
  "author": "Marco Meyer (https://marcomeyer.net)",
  "license": "MIT",
  "private": "true",
  "type": "module",
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "undici": "^8.10.0",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@netlify/blobs": "^10.7.13",
    "@supabase/supabase-js": "^2.112.3",
    "preact": "^10.29.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marco2meyer/causerie"
  }
}
